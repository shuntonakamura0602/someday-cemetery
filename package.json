{
  "name": "someday-cemetery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A quiet resting place for unfinished things.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:webkit": "playwright test --project=webkit-mobile",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@polar-sh/sdk": "1.0.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "pg": "8.23.1",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
