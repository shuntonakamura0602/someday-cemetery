# Application stage: local | preview | production
APP_STAGE=local

# Canonical absolute origin used for same-origin checks and callback URLs
APP_BASE_URL=http://127.0.0.1:3000

# Data implementation: demo | supabase
DATA_BACKEND=demo

# Public Supabase project values; required when DATA_BACKEND=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key; never prefix this with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile public/private keys for reports and abuse protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# New checkout mode: off | sandbox | live
PAYMENTS_MODE=off

# Server-only Polar values for the selected sandbox or live environment
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_WEBHOOK_SECRET=

# Generate separate high-entropy values; do not reuse across purposes or stages
COOKIE_SIGNING_SECRET=
VISITOR_HASH_SECRET=
CRON_SECRET=

# Comma-separated UUIDs of verified, persistent Supabase administrator users
ADMIN_USER_IDS=

# Real public operator details; required before publication
SUPPORT_EMAIL=
OPERATOR_NAME=
